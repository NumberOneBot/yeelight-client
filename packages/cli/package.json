{
  "name": "yeelight-cli",
  "version": "1.4.0",
  "description": "CLI tool for controlling Yeelight smart lights over LAN",
  "license": "MIT",
  "type": "module",
  "author": "NumberOneBot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NumberOneBot/yeelight-client.git",
    "directory": "packages/cli"
  },
  "homepage": "https://numberonebot.github.io/yeelight-client",
  "bugs": "https://github.com/NumberOneBot/yeelight-client/issues",
  "keywords": [
    "yeelight",
    "smart-home",
    "cli",
    "iot",
    "led",
    "smart-light",
    "lan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ylc": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.tsx",
    "dev:i": "bun run src/index.tsx interactive",
    "dev:i:ip": "bun run src/index.tsx interactive --sort ip",
    "build:node": "tsup",
    "build:win": "bun build src/index.tsx --compile --target bun-windows-x64 --outfile dist/ylc.exe",
    "postbuild:win": "node scripts/set-icon.mjs",
    "build:mac-arm64": "bun build src/index.tsx --compile --target bun-darwin-arm64 --outfile dist/ylc",
    "build:linux-x64": "bun build src/index.tsx --compile --target bun-linux-x64 --outfile dist/ylc-linux-x64",
    "build": "pnpm run build:node",
    "icons": "node scripts/make-icon.mjs",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/react": "^19.2.17",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.3",
    "yeelight-client": "workspace:*"
  },
  "dependencies": {
    "ink": "^7.1.0",
    "minimist": "^1.2.8",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1"
  }
}
